const supabase = createClient(Deno.env.get('SUPABASE_URL'), Deno.env.get('SUPABASE_SERVICE_ROLE_KEY'));

export async function handler(req) {
  // 1. Get all students
  const { data: students } = await supabase
    .from('students')
    .select('id, name, programme, avatar_url');

  // 2. For each student, compute their RISE score (reuse logic from getRiseScore)
  // For efficiency, we could store precomputed scores; here we compute on the fly.
  const leaderboard = await Promise.all(students.map(async (s) => {
    // Compute categories (reuse function from getRiseScore)
    const { total, categories } = await calculateRise(s.id);
    return { ...s, total, categories };
  }));

  // Sort descending by total
  leaderboard.sort((a, b) => b.total - a.total);

  return new Response(JSON.stringify(leaderboard), { status: 200 });
}

